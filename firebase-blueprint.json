{
  "entities": {
    "InventoryPart": {
      "title": "InventoryPart",
      "description": "Fleet commercial autoparts tracking item",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique part identifier",
          "maxLength": 128
        },
        "partNumber": {
          "type": "string",
          "description": "Manufacturer part number",
          "maxLength": 128
        },
        "itemName": {
          "type": "string",
          "description": "Descriptive part name",
          "maxLength": 256
        },
        "partDescription": {
          "type": "string",
          "description": "Detailed specifications or usage description",
          "maxLength": 4096
        },
        "category": {
          "type": "string",
          "description": "Vehicle, machinery, or custom auto parts category",
          "maxLength": 128
        },
        "imageUrl": {
          "type": "string",
          "description": "Part photo URL or vector preview",
          "maxLength": 200000
        },
        "supplierName": {
          "type": "string",
          "description": "Fleet supplier or OEM distributor name",
          "maxLength": 256
        },
        "unitPrice": {
          "type": "number",
          "description": "Unit price in dollars"
        },
        "quantityInStock": {
          "type": "number",
          "description": "Current on-hand warehouse quantity"
        },
        "reorderLevel": {
          "type": "number",
          "description": "Minimum threshold before restock required"
        },
        "lastRestockedDate": {
          "type": "string",
          "description": "Date of latest restock in YYYY-MM-DD",
          "maxLength": 64
        },
        "compatibility": {
          "type": "string",
          "description": "Engine, chassis or fleet compatibility notes",
          "maxLength": 1024
        },
        "oemReference": {
          "type": "string",
          "description": "Cross-reference OEM number",
          "maxLength": 128
        }
      },
      "required": [
        "id",
        "partNumber",
        "itemName",
        "category",
        "unitPrice",
        "quantityInStock",
        "reorderLevel"
      ]
    },
    "SaleRecord": {
      "title": "SaleRecord",
      "description": "Log of point-of-sale item sold transaction",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique transaction record identifier",
          "maxLength": 128
        },
        "partNumber": {
          "type": "string",
          "description": "Part number sold",
          "maxLength": 128
        },
        "itemName": {
          "type": "string",
          "description": "Part name",
          "maxLength": 256
        },
        "category": {
          "type": "string",
          "description": "Category of part",
          "maxLength": 128
        },
        "quantitySold": {
          "type": "number",
          "description": "Number of units sold"
        },
        "salePrice": {
          "type": "number",
          "description": "Price per unit at sale time"
        },
        "totalAmount": {
          "type": "number",
          "description": "Total sale value"
        },
        "saleDate": {
          "type": "string",
          "description": "Date or timestamp of transaction",
          "maxLength": 64
        },
        "receiptNumber": {
          "type": "string",
          "description": "POS receipt or invoice identifier",
          "maxLength": 128
        },
        "customerName": {
          "type": "string",
          "description": "Customer or fleet account name",
          "maxLength": 256
        },
        "stockBefore": {
          "type": "number",
          "description": "Stock count before this sale"
        },
        "stockAfter": {
          "type": "number",
          "description": "Stock count after this sale"
        }
      },
      "required": [
        "id",
        "partNumber",
        "itemName",
        "quantitySold",
        "salePrice",
        "totalAmount",
        "saleDate"
      ]
    }
  },
  "firestore": {
    "/inventory_parts/{partId}": {
      "schema": "InventoryPart",
      "description": "Global commercial fleet inventory parts collection accessible by team"
    },
    "/sales_records/{saleId}": {
      "schema": "SaleRecord",
      "description": "Historical sales transactions recorded from POS or tablet"
    }
  }
}
