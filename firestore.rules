rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidPart(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.partNumber is string && data.partNumber.size() > 0 && data.partNumber.size() <= 128 &&
             data.itemName is string && data.itemName.size() > 0 && data.itemName.size() <= 256 &&
             (!('partDescription' in data) || (data.partDescription is string && data.partDescription.size() <= 4096)) &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 128 &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 200000)) &&
             (!('supplierName' in data) || (data.supplierName is string && data.supplierName.size() <= 256)) &&
             data.unitPrice is number && data.unitPrice >= 0 &&
             data.quantityInStock is number && data.quantityInStock >= 0 &&
             data.reorderLevel is number && data.reorderLevel >= 0 &&
             (!('lastRestockedDate' in data) || (data.lastRestockedDate is string && data.lastRestockedDate.size() <= 64)) &&
             (!('compatibility' in data) || (data.compatibility is string && data.compatibility.size() <= 1024)) &&
             (!('oemReference' in data) || (data.oemReference is string && data.oemReference.size() <= 128));
    }

    function isValidSale(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.partNumber is string && data.partNumber.size() > 0 && data.partNumber.size() <= 128 &&
             data.itemName is string && data.itemName.size() > 0 && data.itemName.size() <= 256 &&
             (!('category' in data) || (data.category is string && data.category.size() <= 128)) &&
             data.quantitySold is number && data.quantitySold > 0 &&
             data.salePrice is number && data.salePrice >= 0 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.saleDate is string && data.saleDate.size() <= 64 &&
             (!('receiptNumber' in data) || (data.receiptNumber is string && data.receiptNumber.size() <= 128)) &&
             (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 256)) &&
             (!('stockBefore' in data) || data.stockBefore is number) &&
             (!('stockAfter' in data) || data.stockAfter is number);
    }

    match /inventory_parts/{partId} {
      allow get, list: if true;
      allow create: if isValidId(partId) && isValidPart(incoming()) && incoming().id == partId;
      allow update: if isValidId(partId) && isValidPart(incoming()) && incoming().id == partId;
      allow delete: if isValidId(partId);
    }

    match /sales_records/{saleId} {
      allow get, list: if true;
      allow create: if isValidId(saleId) && isValidSale(incoming()) && incoming().id == saleId;
      allow update: if isValidId(saleId) && isValidSale(incoming()) && incoming().id == saleId;
      allow delete: if isValidId(saleId);
    }
  }
}
